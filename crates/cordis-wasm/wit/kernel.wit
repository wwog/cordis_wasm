package cordis:kernel@0.1.0;

interface host {
    record call-context {
        fiber-id: u64,
        effect-id: u64,
    }

    record service-id {
        name: string,
        abi-hash: list<u8>,
    }

    record event-id {
        name: string,
        abi-hash: list<u8>,
    }

    enum event-mode {
        emit,
        parallel,
        serial,
        bail,
        waterfall,
    }

    variant event-reply {
        continue-value(list<u8>),
        break-value(list<u8>),
    }

    variant kernel-error {
        invalid-argument(string),
        inactive-context,
        inactive-dependency(string),
        undeclared-dependency(string),
        capability-denied(string),
        internal(string),
    }

    resource registration;

    log: func(context: call-context, level: string, message: string);
    call-service: func(
        context: call-context,
        service: service-id,
        method: u32,
        payload: list<u8>,
    ) -> result<list<u8>, kernel-error>;
    provide-service: func(
        context: call-context,
        service: service-id,
    ) -> result<registration, kernel-error>;
    register-listener: func(
        context: call-context,
        event: event-id,
        listener-id: u64,
        mode: event-mode,
    ) -> result<registration, kernel-error>;
    dispatch-event: func(
        context: call-context,
        event: event-id,
        listener-id: u64,
        mode: event-mode,
        payload: list<u8>,
        next-token: option<u64>,
    ) -> result<event-reply, kernel-error>;
}

interface plugin {
    use host.{call-context, event-id, event-mode, event-reply, kernel-error, service-id};

    record plugin-descriptor {
        name: string,
        version: string,
        wit-version: string,
        inject: list<service-id>,
        provide: list<service-id>,
        config-schema: list<u8>,
        capabilities: list<string>,
    }

    descriptor: func() -> plugin-descriptor;
    activate: func(context: call-context, config: list<u8>) -> result<_, kernel-error>;
    deactivate: func(context: call-context) -> result<_, kernel-error>;
    call-service: func(
        context: call-context,
        service: service-id,
        method: u32,
        payload: list<u8>,
    ) -> result<list<u8>, kernel-error>;
    handle-event: func(
        context: call-context,
        event: event-id,
        listener-id: u64,
        mode: event-mode,
        payload: list<u8>,
        next-token: option<u64>,
    ) -> result<event-reply, kernel-error>;
}

world cordis-plugin {
    import host;
    export plugin;
}
